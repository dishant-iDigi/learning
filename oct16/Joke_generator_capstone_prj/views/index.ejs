<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/main.css">
  <title>I'm Bored</title>
</head>

<body>
  <div class="container">
    <h1>Let's find some Joke for You select the type of the joke you would like✌️</h1>

    <form action="/" id="form" class="form" method="POST">
      <select name="type" class="form-select">
        <option value="" data-display="Select">Select </option>
        <option value="Any">Any</option>
        <option value="Dark">Dark</option>
        <option value="Programming">Programming</option>
        <option value="Miscellaneous">Miscellaneous</option>
        <option value="Spooky">Spooky</option>
        <option value="Christmas">Christmas</option>

      </select>
      <select name="flags" class="form-select">
        <option value="" data-display="Select">Select </option>
        <option value="religious">religious</option>
        <option value="political">political</option>
        <option value="racist">racist</option>
        <option value="sexist">sexist</option>
        <option value="explicit">explicit</option>
      </select>
      <button type="submit" class="form-submit">Go</button>
    </form>
    <section id="cards" class="cards">
      <% if(locals.data){ %>
        <article class="card-item">
          <h2 class="card-activity">
            <!-- Show Activity -->
            Category : <%= data.category %> <br>
              Joke Type : <%= data.type %>
          </h2>
          <div class="card-info">
            <span class="card-type">
              <% if(data.setup){ %>
                Joke setup : <%= data.setup %> <br>
                  Joke delivery : <%= data.delivery %>
               <% }else{ %>
                    Joke : <%= data.joke %>
                  <% } %>

            </span>
          </div>
        </article>
        <% } %>

          <% if(locals.error){ %>
            <div id="tag-error" class="tag-error">
              <!-- Show any errors that were sent from the backend -->
              <%= error %>
            </div>
            <% } %>

    </section>
  </div>

</body>

</html>